---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allLectures = await getCollection('lectures');
const sortedLectures = allLectures.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);

const courses = [
  { name: 'Econometrics', slug: 'econometrics', color: 'border-blue-500' },
  { name: 'International Trade Service', slug: 'intl-trade', color: 'border-teal-500' },
  { name: 'International Business', slug: 'intl-business', color: 'border-indigo-500' },
  { name: 'Accounting', slug: 'accounting', color: 'border-emerald-500' },
  { name: 'Industrial Economics', slug: 'industrial-econ', color: 'border-amber-500' },
  { name: 'Inter-Culture Communication', slug: 'intercultural-comm', color: 'border-purple-500' },
  { name: 'International Settlement', slug: 'intl-settlement', color: 'border-sky-500' },
  { name: 'Productivity Economics', slug: 'productivity-econ', color: 'border-red-500' }
];
---

<Layout title="Bachelor Course Notes">
  <main class="w-full space-y-8">
    <section>
      <h1 class="text-2xl font-bold mb-4">Course Subjects</h1>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {courses.map(course => (
          <a href={`/courses/${course.slug}`} class={`p-4 bg-white dark:bg-slate-800 rounded-lg border-l-4 ${course.color} shadow-sm hover:shadow-md transition`}>
            <h2 class="font-semibold">{course.name}</h2>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold mb-4">Recently Updated</h2>
      <div class="bg-white dark:bg-slate-800 rounded-lg divide-y divide-slate-100 dark:divide-slate-700 shadow-sm">
        {sortedLectures.map(lecture => (
          <a href={`/lectures/${lecture.slug}`} class="p-4 block hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
            <div class="flex justify-between items-center">
              <div>
                <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">{lecture.data.subject}</span>
                <h3 class="font-medium">{lecture.data.title}</h3>
              </div>
              <span class="text-xs text-slate-500">{lecture.data.date.toISOString().split('T')[0]}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>