---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const lectures = await getCollection('lectures');
  return lectures.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<Layout title={entry.data.title}>
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 w-full" data-pagefind-body>
    <main class="lg:col-span-3 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-lg shadow-sm border border-slate-200/60 dark:border-slate-700">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-2">
        <span>{entry.data.subject}</span>
        <span>/</span>
        <span>LECTURE {String(entry.data.lectureNumber).padStart(2, '0')} of {entry.data.totalLectures}</span>
        {entry.data.examImportant && (
          <span class="bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 px-2 py-0.5 rounded ml-auto">
            Exam Important
          </span>
        )}
      </div>

      <h1 class="text-3xl font-bold mb-4">{entry.data.title}</h1>

      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </main>

    <aside class="hidden lg:block lg:col-span-1">
      <div class="sticky top-20 bg-white dark:bg-slate-800 p-4 rounded-lg border border-slate-200/60 dark:border-slate-700">
        <h3 class="font-semibold text-sm mb-3">Table of Contents</h3>
        <ul class="text-xs space-y-2">
          {headings.map(h => (
            <li class={`ml-${(h.depth - 1) * 2}`}>
              <a href={`#${h.slug}`} class="text-slate-600 dark:text-slate-400 hover:underline">{h.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</Layout>