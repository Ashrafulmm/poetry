---
import Layout from '../layouts/Layout.astro';

const courses = [
  { name: 'Econometrics', subject: 'Economics', color: 'bg-emerald-500', path: '/econometrics', lectures: 1 },
  { name: 'International Trade', subject: 'Business', color: 'bg-blue-500', path: '/international-trade', lectures: 1 },
  { name: 'International Business', subject: 'Business', color: 'bg-amber-500', path: '/international-business', lectures: 0 },
  { name: 'Financial Management', subject: 'Finance', color: 'bg-purple-500', path: '/financial-management', lectures: 0 },
  { name: 'Marketing Management', subject: 'Marketing', color: 'bg-rose-500', path: '/marketing-management', lectures: 0 },
  { name: 'Organizational Behavior', subject: 'Management', color: 'bg-cyan-500', path: '/organizational-behavior', lectures: 0 },
  { name: 'Business Law', subject: 'Law', color: 'bg-indigo-500', path: '/business-law', lectures: 0 },
  { name: 'Strategic Management', subject: 'Management', color: 'bg-orange-500', path: '/strategic-management', lectures: 0 },
];

const totalLectures = courses.reduce((a, c) => a + c.lectures, 0);
---

<Layout>
  <div class="max-w-4xl mx-auto">
    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-4">Course Notes Hub</h1>
      <p class="text-lg text-slate-600 dark:text-slate-300">All your bachelor's lectures, organized and searchable.</p>
    </header>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 text-center">
        <div class="text-3xl font-bold text-blue-600">{totalLectures}</div>
        <div class="text-sm text-slate-500 mt-1">Lectures</div>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 text-center">
        <div class="text-3xl font-bold text-emerald-600">{courses.length}</div>
        <div class="text-sm text-slate-500 mt-1">Courses</div>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 text-center">
        <div class="text-3xl font-bold text-amber-600">2</div>
        <div class="text-sm text-slate-500 mt-1">Exam Important</div>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 text-center">
        <div class="text-3xl font-bold text-purple-600">8</div>
        <div class="text-sm text-slate-500 mt-1">Subjects</div>
      </div>
    </div>

    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-5">Your Courses</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {courses.map(c => (
        <a href={c.path} class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700 transition-all">
          <div class="flex items-center gap-3 mb-2">
            <span class={`w-3 h-3 rounded-full ${c.color}`}></span>
            <h3 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{c.name}</h3>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400">{c.subject} • {c.lectures} lecture{c.lectures !== 1 ? 's' : ''}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
